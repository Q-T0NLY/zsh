# NEXUS Platform Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (never use in production!)
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application port
PORT=8000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_dev
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_this_password

# Database connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache TTL in seconds
CACHE_TTL=3600

# =============================================================================
# AI PROVIDER CONFIGURATION
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google
GOOGLE_API_KEY=your-key-here
GOOGLE_MODEL=gemini-pro

# Ollama (local)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama2

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_random_string

# JWT secret
JWT_SECRET=change_this_to_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log format: text, json
LOG_FORMAT=json

# Log file path
LOG_FILE=logs/app.log

# Max log file size (MB)
LOG_MAX_SIZE=10

# Log rotation count
LOG_BACKUP_COUNT=5

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable features
ENABLE_API=true
ENABLE_DASHBOARD=true
ENABLE_WEBSOCKET=true
ENABLE_METRICS=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Worker processes (for production)
WORKERS=4

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# Rate limiting (requests per minute)
RATE_LIMIT=100

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Hot reload (development only)
HOT_RELOAD=true

# Debug toolbar (development only)
DEBUG_TOOLBAR=true

# Profiling (development only)
ENABLE_PROFILING=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Webhooks
WEBHOOK_URL=
WEBHOOK_SECRET=

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# =============================================================================
# NOTES
# =============================================================================
# 
# - Never commit this file with real credentials
# - Use different values for each environment
# - Rotate secrets regularly
# - Use strong, random passwords
# - Enable only necessary features in production
#

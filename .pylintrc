# ============================================================================
# Pylint Configuration
# Python code quality and style checking
# ============================================================================

[MASTER]
# Python code to execute during initialization
init-hook='import sys; sys.path.append(".")'

# Use multiple processes for speed
jobs=4

# Pickle collected data for later comparisons
persistent=yes

# List of plugins
load-plugins=

# Discover python modules and packages in the file system subtree
recursive=yes

[MESSAGES CONTROL]
# Disable specific warnings
disable=
    C0103,  # Invalid name (for variables)
    C0114,  # Missing module docstring (we use file-level docstrings)
    C0115,  # Missing class docstring (we document important classes)
    C0116,  # Missing function docstring (we document public functions)
    R0903,  # Too few public methods (OK for data classes)
    R0913,  # Too many arguments (OK for complex functions)
    W0511,  # TODO comments
    W0703,  # Broad except (sometimes necessary)
    R0801,  # Similar lines (can happen in test files)
    E0401,  # Import errors (handled by mypy)

[REPORTS]
# Set the output format
output-format=colorized

# Include message IDs in output
msg-template={path}:{line}:{column}: {msg_id}: {msg} ({symbol})

# Reports
reports=yes
score=yes

[BASIC]
# Good variable names
good-names=i,j,k,ex,_,id,db,ui,ai,os

# Bad variable names
bad-names=foo,bar,baz

# Regular expression for constant names
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$

# Regular expression for variable names
variable-rgx=[a-z_][a-z0-9_]{0,30}$

# Regular expression for function names
function-rgx=[a-z_][a-z0-9_]{2,40}$

# Regular expression for class names
class-rgx=[A-Z_][a-zA-Z0-9]+$

[FORMAT]
# Maximum line length
max-line-length=100

# Maximum number of lines in a module
max-module-lines=1000

# String indentation
indent-string='    '

# Expected indentation
indent-after-paren=4

[DESIGN]
# Maximum number of arguments
max-args=8

# Maximum number of attributes
max-attributes=12

# Maximum number of boolean expressions
max-bool-expr=5

# Maximum number of branches
max-branches=15

# Maximum number of locals
max-locals=20

# Maximum number of parents
max-parents=7

# Maximum number of public methods
max-public-methods=25

# Maximum number of return statements
max-returns=6

# Maximum number of statements
max-statements=60

[SIMILARITIES]
# Minimum lines of similar code
min-similarity-lines=4

# Ignore comments when computing similarities
ignore-comments=yes

# Ignore docstrings when computing similarities
ignore-docstrings=yes

# Ignore imports when computing similarities
ignore-imports=yes

[TYPECHECK]
# List of members which are set dynamically
generated-members=

# List of decorators that produce context managers
contextmanager-decorators=contextlib.contextmanager

[IMPORTS]
# Deprecated modules
deprecated-modules=

# Force import order
import-order-style=google

[EXCEPTIONS]
# Exceptions that will emit a warning
overgeneral-exceptions=Exception
